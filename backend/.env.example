PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/intellihire?retryWrites=true&w=majority
JWT_SECRET=your_production_jwt_secret_key
# Client / Frontend Origins (CORS)
FRONTEND_URL=http://localhost:5173
CLIENT_URL=https://intellihire.vercel.app
AI_SERVICE_URL=https://intellihire-ai-service.onrender.com

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Nodemailer SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password