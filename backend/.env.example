PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/intellihire?retryWrites=true&w=majority
JWT_SECRET=your_production_jwt_secret_key
CLIENT_URL=https://intellihire.vercel.app
AI_SERVICE_URL=https://intellihire-ai-service.onrender.com

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET_NAME=intellihire-resumes-bucket

# Nodemailer SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password